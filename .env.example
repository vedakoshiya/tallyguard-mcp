# ==============================================================================
# TallyGuard MCP - Environment Configuration Template
# NOTE: Copy this file to '.env' for local configuration.
# NEVER COMMIT '.env' OR ANY FILE CONTAINING REAL CREDENTIALS.
# ==============================================================================

# Server Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# MCP Server Settings
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_TRANSPORT=stdio # Options: stdio, http

# Tally Local Connection (Bridge to Tally Prime / ERP 9)
TALLY_HOST=127.0.0.1
TALLY_PORT=9000
TALLY_COMPANY_NAME="Sample Company"
TALLY_TIMEOUT_SECONDS=10

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://tallyguard_user:tallyguard_pass@localhost:5432/tallyguard_db
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Cache & Relay Broker (Optional for stdio mode, required for cloud relay)
REDIS_URL=redis://localhost:6379/0

# Security & Cryptography
# Generate a strong 256-bit key in production: openssl rand -hex 32
JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Draft Approval Policies
DEFAULT_DRAFT_EXPIRY_HOURS=48
DEFAULT_HIGH_VALUE_THRESHOLD=50000.00
REQUIRE_SECOND_APPROVER_HIGH_VALUE=true

# Relay WebSocket Broker (For cloud deployments)
RELAY_BROKER_URL=wss://relay.example.com/ws/bridge
BRIDGE_DEVICE_ID=
BRIDGE_PRIVATE_KEY_PATH=
